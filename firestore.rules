rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let profile = request.resource.data;
        return profile.keys().hasOnly(['basic', 'body', 'goals', 'updatedAt'])
          && profile.basic is map
          && profile.body is map
          && profile.goals is map
          && profile.updatedAt == request.time;
      }
      match /routines/{routineId} {
        allow read: if owner();
        allow create, update: if owner()
          && request.resource.data.name is string
          && request.resource.data.exercises is list
          && request.resource.data.syncedAt == request.time;
      }

      match /workouts/{workoutId} {
        allow read: if owner();
        allow create, update: if owner()
          && request.resource.data.name is string
          && request.resource.data.endedAtMs is int
          && request.resource.data.sets is list
          && request.resource.data.sets.size() > 0
          && request.resource.data.syncedAt == request.time;
      }

      allow get: if owner();
      allow create, update: if owner() && validProfile();
    }
  }
}
